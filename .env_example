# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
CITY_NAME=Karachi
CITY_LAT=24.8608
CITY_LON=67.0104
LOCAL_UTC_OFFSET_HOURS=5
REPORT_HOUR_UTC=1
 
OPENWEATHER_API_KEY=your_openweather_api_key 
AQICN_TOKEN=your_aqicn_token
# Karachi US Consulate station (find yours with the search command in the guide, Step 3)
AQICN_STATION=@11790
# optional: force specific Groq models (names change over time; the code finds a working one if these fail)
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
GROQ_API_KEY=your_groq_api_key
HOPSWORKS_API_KEY=your_hopsworks_api_key
HOPSWORKS_PROJECT=your_hopsworks_project
# optional: Discord/Slack incoming webhook used by the Drift Agent to alert the team
ALERT_WEBHOOK_URL=
# optional: only if your Hopsworks project is not on the default host
HOPSWORKS_HOST=
# training: 2 years of history, 30-day validation window
VAL_DAYS=30
