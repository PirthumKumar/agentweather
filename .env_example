# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
CITY_NAME=Karachi
CITY_LAT=24.8608
CITY_LON=67.0104
LOCAL_UTC_OFFSET_HOURS=5
 
OPENWEATHER_API_KEY=your_openweather_api_key 
AQICN_TOKEN=your_aqicn_token
GROQ_API_KEY=your_groq_api_key
HOPSWORKS_API_KEY=your_hopsworks_api_key
HOPSWORKS_PROJECT=your_hopsworks_project
# optional: Discord/Slack incoming webhook used by the Drift Agent to alert the team
ALERT_WEBHOOK_URL=
